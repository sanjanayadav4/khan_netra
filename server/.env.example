# ═══════════════════════════════════════════════════════════════════════════
# KhanNetra DGMS — Server Environment Variables
# ───────────────────────────────────────────────────────────────────────────
# Copy this file to server/.env for local development.
# NEVER commit server/.env — it is in .gitignore.
#
# For PRODUCTION (Render.com):
#   Set these variables in the Render dashboard → Environment tab.
#   Never paste real values here or in chat.
# ═══════════════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development        # Set to: production  on Render
PORT=5000                   # Render sets PORT=10000 automatically

# ── JWT  (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=CHANGE_ME_strong_random_64_char_hex
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=CHANGE_ME_different_strong_random_64_char_hex
JWT_REFRESH_EXPIRES_IN=7d

# ── URLs ─────────────────────────────────────────────────────────────────────
# CLIENT_URL   — used for email verification links and single-origin CORS fallback
#   Dev:         http://localhost:3000
#   Production:  https://khannettra.vercel.app
CLIENT_URL=http://localhost:3000

# DEV_CLIENT_URL — optional LAN override (leave empty in production)
DEV_CLIENT_URL=

# ALLOWED_ORIGINS — comma-separated list of ALL allowed CORS origins
#   Dev:         http://localhost:3000,http://127.0.0.1:3000
#   Production:  https://khannettra.vercel.app,https://khannetra.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── File uploads ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# ── Rate limiting (per 15-minute window per IP) ───────────────────────────────
REGISTER_RATE_LIMIT=10
RESEND_RATE_LIMIT=5
LOGIN_RATE_LIMIT=20

# ── AI / Gemini ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── AI Safety Vision ─────────────────────────────────────────────────────────
MODEL_BACKEND=gemini

# ═══════════════════════════════════════════════════════════════════════════
# EMAIL / SMTP — Transactional email (REQUIRED for email verification)
# ───────────────────────────────────────────────────────────────────────────
# Gmail App Password: https://myaccount.google.com/apppasswords
# (spaces in the 16-char password are stripped automatically)
#
# Production alternatives: Sendgrid, Mailgun, Amazon SES, Resend
# ═══════════════════════════════════════════════════════════════════════════
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KhanNetra DGMS <>
