# ═══════════════════════════════════════════════════════════════════════════
# KhanNetra DGMS — Client Environment Variables
# ───────────────────────────────────────────────────────────────────────────
# For LOCAL DEVELOPMENT: copy to client/.env
# For PRODUCTION (Vercel): set these in the Vercel dashboard →
#   Project Settings → Environment Variables → Production
#
# Only VITE_* variables are exposed to the browser bundle.
# NEVER put secrets here.
# ═══════════════════════════════════════════════════════════════════════════

# ── Production API URL ───────────────────────────────────────────────────────
# REQUIRED for production — set this to your Render backend URL.
# Leave empty locally (Vite proxy handles /api → localhost:5000).
#
# Production value (set in Vercel dashboard):
#   VITE_API_URL=https://khannetra-api.onrender.com/api/v1
#
# DO NOT set this to localhost in production — the browser cannot
# reach localhost:5000 when running on khannettra.vercel.app.
VITE_API_URL=

# ── Vite dev proxy target ─────────────────────────────────────────────────────
# Only used locally. Override if your local backend runs on a different port.
VITE_BACKEND_URL=http://localhost:5000
